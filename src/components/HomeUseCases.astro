---
const useCases = [
	{
		title: 'A personal agent fleet',
		body: 'Long-lived assistants that keep their tools, repos, and memory. Always on, on hardware you control.',
		href: '/use-cases/personal-agent-fleet/',
	},
	{
		title: 'An autonomous dev team',
		body: 'A team of agents that takes GitHub issues to reviewed, merged pull requests: planner, builders, and reviewers, each in its own pod.',
		href: '/use-cases/autonomous-dev-team/',
	},
	{
		title: 'Ops from your phone',
		body: 'Run infrastructure through a conversation: assign work from Telegram, approve decisions, and get results without opening a laptop.',
		href: '/use-cases/ops-from-your-phone/',
	},
	{
		title: 'Scheduled automation',
		body: 'Agents on cron: nightly audits, weekly reports, monitors that investigate before they page you. The schedules survive restarts.',
		href: '/use-cases/scheduled-automation/',
	},
];
---

<section class="ky-section">
	<div class="ky-section-header">
		<span class="ky-kicker">Use cases</span>
		<h2>What people run on Kyber</h2>
		<p>
			Kyber is the platform layer under the agents. Here is what fleets look
			like in practice.
		</p>
	</div>
	<div class="ky-grid">
		{
			useCases.map((u) => (
				<a class="ky-card" href={u.href}>
					<h3>{u.title}</h3>
					<p>{u.body}</p>
					<span class="ky-more">Read more →</span>
				</a>
			))
		}
	</div>
</section>
